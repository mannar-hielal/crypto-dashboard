{
  "name": "crypto-paper-trade",
  "version": "0.1.0",
  "description": "Stop paying to learn paper trade",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "MannarHielal",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "preinstall": "pnpm audit --audit-level=high",
    "dev:server": "pnpm --filter @crypto-dashboard/server dev",
    "dev": "pnpm dev:server",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=high",
    "type-check": "pnpm --filter @crypto-dashboard/server type-check && pnpm --filter @crypto-dashboard/client type-check",
    "test": "pnpm --filter @crypto-dashboard/server test && pnpm --filter @crypto-dashboard/client test",
    "test:coverage": "pnpm --filter @crypto-dashboard/server test:coverage && pnpm --filter @crypto-dashboard/client test:coverage"
  },
  "keywords": [
    "crypto",
    "trading",
    "paper-trading",
    "bybit",
    "charts",
    "indicators"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.29.0",
      "serialize-javascript": "^7.0.5",
      "ws": "^8.21.0",
      "@hono/node-server": ">=2.0.5",
      "esbuild": ">=0.28.1",
      "axios": ">=1.18.0",
      "brace-expansion": ">=5.0.9",
      "js-yaml": ">=5.2.2",
      "fast-uri": ">=4.1.3",
      "sharp": ">=0.35.4",
      "hono": ">=4.12.34",
      "body-parser": ">=2.3.0",
      "find-my-way": ">=9.7.0",
      "@fastify/static": ">=10.1.1",
      "postcss": ">=8.5.18",
      "ip-address": ">=10.3.1",
      "nanoid": ">=3.3.18",
      "deepmerge-ts": ">=8.0.0",
      "browserslist": ">=4.28.7",
      "mysql2": ">=3.22.0",
      "valibot@<=1.4.1": ">=1.4.2",
      "undici@>=7.0.0 <7.29.0": "^7.29.0",
      "fast-uri@>=4.0.0 <4.1.3": ">=4.1.3",
      "ip-address@>=10.1.1 <=10.2.1": ">=10.2.2",
      "ip-address@>=10.1.1 <=10.2.0": ">=10.2.1",
      "hono@<4.12.34": ">=4.12.34",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "hono@>=3.8.0 <4.12.34": ">=4.12.34",
      "hono@>=4.7.0 <4.12.34": ">=4.12.34",
      "hono@>=4.12.0 <4.12.34": ">=4.12.34",
      "nanoid@<3.3.18": ">=3.3.18"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
