{
  "name": "crypto-paper-trade",
  "version": "0.1.0",
  "description": "Stop paying to learn paper trade",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "MannarHielal",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:server": "pnpm --filter @crypto-dashboard/server dev",
    "dev": "pnpm dev:server",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=high",
    "type-check": "pnpm --filter @crypto-dashboard/server type-check",
    "test": "pnpm --filter @crypto-dashboard/server test && pnpm --filter @crypto-dashboard/client test",
    "test:coverage": "pnpm --filter @crypto-dashboard/server test:coverage && pnpm --filter @crypto-dashboard/client test:coverage"
  },
  "keywords": [
    "crypto",
    "trading",
    "paper-trading",
    "bybit",
    "charts",
    "indicators"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
