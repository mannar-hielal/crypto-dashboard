{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Weekly mutation testing of the trading engine (docs/TRADING_TEST_PLAN.md roadmap P4, M7; .claude/rules/testing.md). Run: pnpm --filter @crypto-dashboard/server test:mutation. break = the floor: 2 points under the first score (69.12%, 2026-09-30), raised quarterly, never lowered.",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.config.ts", "related": true },
  "mutate": ["src/trading/engine/**/*.ts", "!src/trading/engine/__tests__/**"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "tempDirName": ".stryker-tmp",
  "concurrency": 4,
  "timeoutMS": 20000,
  "thresholds": { "high": 80, "low": 60, "break": 67 }
}
