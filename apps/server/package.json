    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "argon2": "^0.44.0",
    "bybit-api": "^4.6.1",
    "dotenv": "^17.4.0",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.1",
    "pg": "^8.20.16",
    "pino": "^10.3.1",
    "prisma": "^7.6.0",
    "resend": "^6.10.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.2",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
