{
  "name": "@crypto-dashboard/server",
  "version": "0.1.0",
  "description": "Fastify backend for cryptopapertrade.com paper trading platform",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "type-check": "tsc --noEmit",
    "prisma:studio": "prisma studio",
