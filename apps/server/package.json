{
  "name": "@crypto-dashboard/server",
  "version": "0.1.0",
  "description": "Fastify backend for cryptopapertrade.com paper trading platform",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "type-check": "tsc --noEmit && tsc -p tsconfig.contract.json",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:props": "vitest run src/trading/engine/__tests__/invariants.prop.test.ts",
    "test:mutation": "stryker run",
    "parity:testnet": "tsx src/tools/bybitParity.ts",
    "record:bybit": "tsx src/tools/recordBybitFixtures.ts",
    "fake-bybit": "tsx src/tools/fakeBybit/main.ts",
    "feed": "tsx src/tools/feedCtl.ts"
  },
  "dependencies": {
    "@crypto-dashboard/sdk": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/websocket": "^11.3.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.44.0",
    "bybit-api": "^4.8.4",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "resend": "^6.37.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
