// cryptopapertrade.com - Paper Trading Platform
// Phase 1 Database Schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String // argon2id hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 📧 Email Verification
  emailVerifiedAt DateTime? // null = unverified

  // ⚖️ Legal Compliance (Phase 1)
  termsAcceptedAt DateTime? // captures exactly when user agreed
  termsAcceptedIp String?   // captures IP for legal audit trail

  // 🗑️ Account Deletion (Phase 3)
  deletionRequestedAt  DateTime? // null = active; non-null = pending deletion
  deletionWarningSentAt DateTime? // null = warning not yet sent; non-null = already sent

  // Relations
  account             Account?
  trades              Trade[]
  orders              Order[]
  positions           Position[]
  refreshTokens       RefreshToken[] // 🔐 active sessions
  passwordResetTokens PasswordResetToken[] // 🔐 pending resets
  verificationTokens  VerificationToken[]  // 🔐 pending email verifications
  emailChangeTokens   EmailChangeToken[]   // 🔐 pending email changes

  @@index([email])
  @@index([username])
}

// 🔐 One row per active session. Deleted on logout. Rotated on refresh.
model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 of the raw token — never store raw
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 🔐 One-time use. Expires in 1 hour. Marked usedAt after consumption.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 of the raw token
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime? // null = unused, non-null = already consumed
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 🔐 One-time use. Used for account registration / manual re-verification.
model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 🔐 One-time use. Stores the "intended" new email until verified.
model EmailChangeToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// ACCOUNT & BALANCE
// ============================================================================

model Account {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Virtual balance tracking
  totalBalance     Decimal @default(10000) @db.Decimal(20, 8)
  availableBalance Decimal @default(10000) @db.Decimal(20, 8)
  unrealizedPnl    Decimal @default(0) @db.Decimal(20, 8)
  realizedPnl      Decimal @default(0) @db.Decimal(20, 8)

  // Metadata
  lastReset  DateTime @default(now())
  resetCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  trades Trade[]
  orders Order[]
  positions Position[]
}

// ============================================================================
// POSITIONS (Active open positions)
// ============================================================================

model Position {
  id        String  @id @default(cuid())
  refId     String? @unique // Client-side reference ID
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  symbol     String
  side       String // "LONG" | "SHORT"
  quantity   Decimal @db.Decimal(20, 8)
  entryPrice Decimal @db.Decimal(20, 8)
  margin     Decimal @db.Decimal(20, 8) // entryUsdtAmount

  takeProfit Decimal? @db.Decimal(20, 8)
  stopLoss   Decimal? @db.Decimal(20, 8)

  openedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([symbol])
}

// ============================================================================
// ORDERS (Virtual Order State Machine)
// ============================================================================

model Order {
  id        String  @id @default(cuid())
  refId     String? @unique // Client-side reference ID
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Order details
  symbol    String
  side      String // "BUY" | "SELL" (or "LONG" | "SHORT" for positions)
  orderType String // "MARKET" | "LIMIT" | "STOP" | "TAKE_PROFIT" | "STOP_LOSS"
  quantity  Decimal @db.Decimal(20, 8)

  // Pricing
  limitPrice         Decimal? @db.Decimal(20, 8)
  stopPrice          Decimal? @db.Decimal(20, 8)
  takeProfit         Decimal? @db.Decimal(20, 8)
  stopLoss           Decimal? @db.Decimal(20, 8)
  filledQuantity     Decimal  @default(0) @db.Decimal(20, 8)
  averageFilledPrice Decimal? @db.Decimal(20, 8)

  // Financials
  margin     Decimal @default(0) @db.Decimal(20, 8)
  commission Decimal @default(0) @db.Decimal(20, 8)

  // State machine: PENDING -> PARTIALLY_FILLED -> FILLED | CANCELLED | REJECTED
  status          String    @default("PENDING")
  rejectionReason String?
  createdAt       DateTime  @default(now())
  filledAt        DateTime?
  cancelledAt     DateTime?

  // Metadata
  updatedAt DateTime @updatedAt

  // Relations
  trades Trade[]

  @@index([userId])
  @@index([accountId])
  @@index([symbol])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// TRADES (Completed executions)
// ============================================================================

model Trade {
  id        String  @id @default(cuid())
  refId     String? @unique // Client-side reference ID
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Trade execution details
  symbol        String
  side          String // "BUY" | "SELL"
  quantity      Decimal @db.Decimal(20, 8)
  executedPrice Decimal @db.Decimal(20, 8)
  entryPrice    Decimal? @db.Decimal(20, 8)
  totalCost     Decimal @db.Decimal(20, 8)
  commission    Decimal @default(0) @db.Decimal(20, 8)

  // PnL
  pnl        Decimal @default(0) @db.Decimal(20, 8)
  pnlPercent Decimal @default(0) @db.Decimal(6, 4)

  // Metadata
  openedAt   DateTime?
  executedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([accountId])
  @@index([symbol])
  @@index([executedAt])
}
