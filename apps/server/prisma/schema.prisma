// cryptopapertrade.com - Paper Trading Platform
// Phase 1 Database Schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String // argon2id hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 📧 Email Verification
  emailVerifiedAt DateTime? // null = unverified

  // ⚖️ Legal Compliance (Phase 1)
  termsAcceptedAt DateTime? // captures exactly when user agreed
  termsAcceptedIp String? // captures IP for legal audit trail

  // 🗑️ Account Deletion (Phase 3)
  deletionRequestedAt   DateTime? // null = active; non-null = pending deletion
  deletionWarningSentAt DateTime? // null = warning not yet sent; non-null = already sent

  // Relations
  account             Account?
  trades              Trade[]
  orders              Order[]
  positions           Position[]
  journalEntries      JournalEntry[]
  balanceEvents       BalanceEvent[]
  refreshTokens       RefreshToken[] // 🔐 active sessions
  passwordResetTokens PasswordResetToken[] // 🔐 pending resets
  verificationTokens  VerificationToken[] // 🔐 pending email verifications
  emailChangeTokens   EmailChangeToken[] // 🔐 pending email changes

  @@index([email])
  @@index([username])
}

// 🔐 One row per active session. Deleted on logout. Rotated on refresh.
model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 of the raw token — never store raw
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 🔐 One-time use. Expires in 1 hour. Marked usedAt after consumption.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 of the raw token
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime? // null = unused, non-null = already consumed
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 🔐 One-time use. Used for account registration / manual re-verification.
model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 🔐 One-time use. Stores the "intended" new email until verified.
model EmailChangeToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// NEWSLETTER (Pre-launch waitlist)
// ============================================================================

enum SubscriberStatus {
  pending
  verified
  unsubscribed
}

model Subscriber {
  id         String           @id @default(cuid())
  email      String           @unique
  status     SubscriberStatus @default(pending)
  tokenHash  String           @unique // SHA-256 of verification token
  consentIp  String?
  createdAt  DateTime         @default(now())
  verifiedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// ACCOUNT & BALANCE
// ============================================================================

model Account {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Virtual balance tracking
  totalBalance     Decimal @default(10000) @db.Decimal(20, 8)
  availableBalance Decimal @default(10000) @db.Decimal(20, 8)
  unrealizedPnl    Decimal @default(0) @db.Decimal(20, 8)
  realizedPnl      Decimal @default(0) @db.Decimal(20, 8)

  // Default leverage (1..MAX_LEVERAGE) for a symbol with no SymbolSetting row (BP-2: leverage is
  // per symbol; this was the account-wide leverage in BP-1)
  leverage Int @default(1)
  // Optimistic concurrency: every engine/API mutation bumps it (updateMany where version = v),
  // so two concurrent mutations of one account can never both commit (BP-1)
  version  Int @default(0)
  // Margin mode, account-wide as in Bybit UTA (BP-5 E): "REGULAR_MARGIN" = cross (Bybit's default,
  // and new accounts') | "ISOLATED_MARGIN". Accounts from before BP-5 were migrated to isolated
  marginMode       String  @default("REGULAR_MARGIN")
  // True for an account that was isolated before cross existed: the client shows a one-time
  // notice about cross margin (O2). Cleared by a mode switch
  marginModeNotice Boolean @default(false)

  // Metadata
  lastReset  DateTime @default(now())
  resetCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  trades         Trade[]
  orders         Order[]
  positions      Position[]
  journalEntries JournalEntry[]
  balanceEvents  BalanceEvent[]
  symbolSettings SymbolSetting[]
  spotBalances   SpotBalance[]
}

// ============================================================================
// SPOT COIN BALANCES (BP-2 — the USDT wallet is Account.availableBalance)
// ============================================================================

model SpotBalance {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  coin      String
  // Sellable now
  free      Decimal  @default(0) @db.Decimal(20, 8)
  // Backing resting sell / TP / SL orders
  locked    Decimal  @default(0) @db.Decimal(20, 8)
  // Average cost per coin in USDT, fees included
  avgCost   Decimal  @default(0) @db.Decimal(20, 8)
  updatedAt DateTime @updatedAt

  @@unique([accountId, coin])
}

// ============================================================================
// PER-SYMBOL SETTINGS (BP-2 — USDT Perpetual leverage and margin mode per symbol)
// ============================================================================

model SymbolSetting {
  id         String  @id @default(cuid())
  accountId  String
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol     String
  leverage   Int     @default(1)
  // Only "isolated" in BP-2
  marginMode String  @default("isolated")
  // Last funding timestamp settled for this account and symbol (BP-4) — a settlement at or before it
  // is a no-op, so the same funding is never charged twice
  lastFundingAt DateTime?
  // False when the row exists only for lastFundingAt: its leverage is then not a per-symbol choice
  // and the symbol keeps following the account default (BP-4)
  leveragePinned Boolean @default(true)

  @@unique([accountId, symbol])
}

// ============================================================================
// POSITIONS (Active open positions)
// ============================================================================

model Position {
  id        String  @id @default(cuid())
  refId     String? @unique // Client-side reference ID
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  symbol     String
  side       String // "LONG" | "SHORT"
  quantity   Decimal @db.Decimal(20, 8)
  entryPrice Decimal @db.Decimal(20, 8)
  margin     Decimal @db.Decimal(20, 8) // initial margin (entryUsdtAmount)

  // BP-2: every position is a USDT Perpetual (spot has coin balances, not positions)
  category        String  @default("linear")
  leverage        Int     @default(1)
  marginMode      String  @default("isolated")
  // Open fee actually charged — the close uses it, never a recomputation at today's rate
  entryFee        Decimal @default(0) @db.Decimal(20, 8)
  // Estimated close fee held with the margin at open (Bybit's position margin = IM + this).
  // BP-3: priced at the bankruptcy price, as Bybit estimates it (BP-2 rows keep theirs)
  closeFeeReserve Decimal @default(0) @db.Decimal(20, 8)
  // Margin added by hand on top of IM (BP-5). Liquidation / bankruptcy prices are derived from
  // the position and the symbol's risk-limit tiers when needed — never stored (BP-3)
  extraMargin     Decimal @default(0) @db.Decimal(20, 8)
  // Funding settled on this position so far, signed as Bybit: positive = paid (BP-4)
  cumFunding      Decimal @default(0) @db.Decimal(20, 8)

  takeProfit Decimal? @db.Decimal(20, 8)
  stopLoss   Decimal? @db.Decimal(20, 8)
  // Price each exit leg triggers on (BP-5 B): "LastPrice" | "MarkPrice" | "IndexPrice"
  tpTriggerBy String @default("LastPrice")
  slTriggerBy String @default("LastPrice")

  openedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([symbol])
  @@index([category, symbol])
}

// ============================================================================
// ORDERS (Virtual Order State Machine)
// ============================================================================

model Order {
  id        String  @id @default(cuid())
  // Insertion order: rows written in the same instant (one action) keep their display order
  seq       Int     @default(autoincrement())
  refId     String? @unique // Client-side reference ID
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Order details
  category  String  @default("linear") // "spot" | "linear" (BP-2)
  symbol    String
  side      String // "BUY" | "SELL" (or "LONG" | "SHORT" for positions)
  orderType String // "MARKET" | "LIMIT" | "STOP" | "TAKE_PROFIT" | "STOP_LOSS"
  quantity  Decimal @db.Decimal(20, 8)

  // Pricing
  limitPrice         Decimal? @db.Decimal(20, 8)
  stopPrice          Decimal? @db.Decimal(20, 8)
  takeProfit         Decimal? @db.Decimal(20, 8)
  stopLoss           Decimal? @db.Decimal(20, 8)
  filledQuantity     Decimal  @default(0) @db.Decimal(20, 8)
  averageFilledPrice Decimal? @db.Decimal(20, 8)

  // Financials
  margin     Decimal  @default(0) @db.Decimal(20, 8)
  commission Decimal  @default(0) @db.Decimal(20, 8)
  // Leverage captured at placement — a pending order fills with it, not the account's
  // leverage at fill time (BP-1 S2)
  leverage   Int      @default(1)
  // PENDING rows: exactly what placing it took from the balance — cancel / edit / fill refund
  // this, never a recomputation at today's fee rate (BP-2)
  reserved   Decimal  @default(0) @db.Decimal(20, 8)
  // Fee actually charged on a fill (BP-2). Null on pre-BP-2 non-fill rows.
  feeRate    Decimal? @db.Decimal(10, 6)
  feeAsset   String?
  isMaker    Boolean?
  // Spot TP / SL pair: both legs share one coin lock; filling one cancels the other
  ocoGroup   String?
  // Bybit createType of a system order: "CreateByLiq" = the close of a liquidated position (BP-3)
  createType String?
  // BP-5 B: the price a stop order and its TP / SL legs trigger on ("LastPrice" | "MarkPrice" |
  // "IndexPrice" — a limit always rests on the last price), and Bybit's reduce-only /
  // close-on-trigger flags
  triggerBy      String  @default("LastPrice")
  tpTriggerBy    String  @default("LastPrice")
  slTriggerBy    String  @default("LastPrice")
  reduceOnly     Boolean @default(false)
  closeOnTrigger Boolean @default(false)

  // State machine: PENDING -> PARTIALLY_FILLED -> FILLED | CANCELLED | REJECTED
  status          String    @default("PENDING")
  rejectionReason String?
  createdAt       DateTime  @default(now())
  filledAt        DateTime?
  cancelledAt     DateTime?

  // Metadata
  updatedAt DateTime @updatedAt

  // Relations
  trades Trade[]

  @@index([userId])
  @@index([accountId])
  @@index([symbol])
  @@index([status])
  @@index([createdAt])
  @@index([status, symbol]) // matching engine's open-order scan
  @@index([status, category, symbol])
  @@index([userId, seq])
}

// ============================================================================
// TRADES (Completed executions)
// ============================================================================

model Trade {
  id        String  @id @default(cuid())
  // Insertion order: rows written in the same instant (one action) keep their display order
  seq       Int     @default(autoincrement())
  refId     String? @unique // Client-side reference ID
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Trade execution details
  category      String   @default("linear") // "spot" | "linear" (BP-2)
  symbol        String
  side          String // "BUY" | "SELL"
  quantity      Decimal  @db.Decimal(20, 8)
  executedPrice Decimal  @db.Decimal(20, 8)
  entryPrice    Decimal? @db.Decimal(20, 8)
  totalCost     Decimal  @db.Decimal(20, 8)
  commission    Decimal  @default(0) @db.Decimal(20, 8)

  // PnL — pnl is net of both commission legs; grossPnl is the price move only (what the
  // History tab shows)
  pnl        Decimal  @default(0) @db.Decimal(20, 8)
  grossPnl   Decimal? @db.Decimal(20, 8)
  // (12, 4): a leveraged trade can return well over 100% (was (6, 4) — overflowed, BP-1 S4)
  pnlPercent Decimal  @default(0) @db.Decimal(12, 4)
  // Bybit execType: "Trade" | "BustTrade" (liquidation at the bankruptcy price, BP-3) | "Funding"
  // (a funding settlement, BP-4: executedPrice = mark, commission = the fee, + = paid)
  execType   String   @default("Trade")
  // Funding rate of a "Funding" row
  feeRate    Decimal? @db.Decimal(12, 8)
  // A close's share of the position's funding (Closed P&L is net of it; realized PnL booked it at
  // each settlement)
  funding    Decimal  @default(0) @db.Decimal(20, 8)
  // A close's share of the position's open fee (BP-5 D): Bybit's closedPnl = grossPnl − openFee −
  // commission − funding. 0 on rows from before BP-5 (their open fee is only in realized PnL)
  openFee    Decimal  @default(0) @db.Decimal(20, 8)

  // Metadata
  openedAt   DateTime?
  executedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([accountId])
  @@index([symbol])
  @@index([executedAt])
  @@index([userId, seq])
  @@index([userId, execType, seq])
}

// ============================================================================
// JOURNAL (engine events + user notes — BP-1: moved from browser localStorage)
// ============================================================================

model JournalEntry {
  id         String   @id @default(cuid())
  // Insertion order: rows written in the same instant (one action) keep their display order
  seq        Int      @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  time       DateTime
  text       String   @db.VarChar(500)
  isUserNote Boolean  @default(false)
  pnl        Decimal? @db.Decimal(20, 8)
  createdAt  DateTime @default(now())

  // Capped at 200 per user (pruned in the same transaction as each insert)
  @@index([userId, seq])
}

// ============================================================================
// BALANCE HISTORY (BP-1: moved from browser localStorage)
// ============================================================================

model BalanceEvent {
  id            String   @id @default(cuid())
  // Insertion order: rows written in the same instant (one action) keep their display order
  seq           Int      @default(autoincrement())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  time          DateTime
  balanceBefore Decimal  @db.Decimal(20, 8)
  balanceAfter  Decimal  @db.Decimal(20, 8)
  pnl           Decimal  @db.Decimal(20, 8)
  action        String   @db.VarChar(300)
  createdAt     DateTime @default(now())

  // Capped at 200 per user (pruned in the same transaction as each insert)
  @@index([userId, seq])
}

// ============================================================================
// MATCHING ENGINE LEASE (BP-1 — exactly one executor across machines)
// ============================================================================

// A single row, id = 'matching-engine'. The holder renews expiresAt every few seconds; another
// instance can take over only once it has expired. Plain Prisma updateMany/create — no raw SQL
// advisory lock (web.md: no raw SQL).
model EngineLease {
  id         String    @id
  holder     String
  expiresAt  DateTime
  // Last tick the holder evaluated — backfill after a restart/outage starts here
  lastTickAt DateTime?
  updatedAt  DateTime  @updatedAt
}
