# Production API URL — baked into the client bundle at build time by Vite.
# This file is intentionally committed: it contains no secrets, only the
# public API base URL. Cloudflare Pages env var (VITE_API_URL) is a belt-and-
# suspenders fallback, but this file is the authoritative source of truth.
VITE_API_URL=https://api.cryptopapertrade.com

