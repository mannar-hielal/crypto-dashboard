# ================================
# App
# ================================
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ================================
# Database (PostgreSQL)
# Format: postgresql://USER@HOST:PORT/DATABASE
# ================================
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/crypto_dashboard_dev

# ================================
# Redis
# ================================
REDIS_URL=redis://localhost:6379

# ================================
# Bybit API (use testnet keys for development)
# Get keys at: https://testnet.bybit.com → Account → API Management
# ================================
BYBIT_API_KEY=your_bybit_testnet_api_key
BYBIT_API_SECRET=your_bybit_testnet_api_secret
BYBIT_TESTNET=true

# ================================
# JWT — generate with: openssl rand -base64 32
# 🔐 NEVER commit real secrets to git
# ================================
JWT_SECRET=generate_a_random_string_with_openssl

# ================================
# CORS (frontend origin)
# 🔐 In production: set to your exact frontend domain — no trailing slash
# ================================
CORS_ORIGIN=http://localhost:5173

