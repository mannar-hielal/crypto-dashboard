#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# 1. Visual Reminder of Manual Checks
echo "\033[0;33m📋 REVIEW CHECKLIST REMINDER\033[0m"
echo "---------------------------------------"
echo "- No secrets in code? Check .env.example"
echo "- Security comments (🔐) added?"
echo "- SDK types updated for API changes?"
echo "Full list: .claude/skills/bug-sweep/SKILL.md (138 items, P1-P12)"
echo "---------------------------------------"

# 2. Automated Enforcement Gates

# 🔐 Dependency CVE check — fails on high/critical advisories
pnpm run audit

# Type-check catches errors ESLint misses
pnpm --filter @crypto-dashboard/server type-check
pnpm --filter @crypto-dashboard/client type-check

# Run tests (Mirroring the 'Tests pass' checklist item)
pnpm test

# Auto-fix + format staged files
pnpm lint-staged

# Full project lint mirroring CI
pnpm lint

