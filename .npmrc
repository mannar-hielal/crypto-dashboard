only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=argon2
only-built-dependencies[]=esbuild
only-built-dependencies[]=prisma

# Peer dependency rules - pnpm 10+ uses .npmrc for these settings
allowed-versions[eslint-plugin-react-hooks]>eslint=10

# Ensure peers are installed automatically
auto-install-peers=true

